<!DOCTYPE html>
<html lang="si">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPDA - Professional Admin Dashboard</title>
    <!-- Google Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background: #f1f5f9; color: #1e293b; display: flex; height: 100vh; overflow: hidden; }
        
        /* Sidebar */
        .sidebar { width: 310px; background: #ffffff; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; z-index: 10; overflow-y: auto; box-shadow: 2px 0 10px rgba(0,0,0,0.02); }
        .sidebar-brand { padding: 24px; font-size: 18px; font-weight: 700; color: #1e3a8a; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #f1f5f9; }
        .sidebar-brand i { color: #d97706; }
        
        .nav-links { list-style: none; padding: 20px 15px; }
        .nav-item { padding: 12px 16px; margin-bottom: 8px; border-radius: 12px; cursor: pointer; transition: all 0.3s ease; color: #64748b; font-size: 14px; font-weight: 500; display: flex; align-items: center; justify-content: space-between; }
        .nav-item i { font-size: 15px; margin-right: 10px; }
        .nav-left { display: flex; align-items: center; }
        .nav-item:hover, .nav-item.active { background: #eff6ff; color: #1d4ed8; font-weight: 600; box-shadow: 0 2px 6px rgba(29, 78, 216, 0.08); }
        
        /* Sub-menus */
        .sub-menu { list-style: none; padding-left: 20px; margin-top: 5px; margin-bottom: 10px; display: none; }
        .sub-menu li { padding: 8px 12px; margin-bottom: 4px; font-size: 13px; color: #64748b; border-radius: 8px; cursor: pointer; transition: 0.2s; }
        .sub-menu li:hover { background: #fef3c7; color: #b45309; }
        
        /* Filter Control Panels inside Sidebar */
        .filter-panel { padding: 15px; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 12px; margin: 5px 0 15px 0; display: none; }
        .filter-panel h4 { color: #1e3a8a; font-size: 13px; margin-bottom: 10px; font-weight: 650; }
        .filter-group { margin-bottom: 10px; }
        .filter-group label { display: block; font-size: 11px; color: #475569; margin-bottom: 4px; font-weight: 600; }
        .filter-group select, .filter-group input { width: 100%; padding: 8px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; color: #1e293b; font-size: 12px; outline: none; }

        /* Main Content */
        .main-content { flex: 1; display: flex; flex-direction: column; overflow-y: auto; background: #f8fafc; }
        
        .header { padding: 20px 35px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; }
        .header h2 { color: #0f172a; font-size: 20px; font-weight: 600; }
        .header h2 span { color: #2563eb; }
        .user-profile { display: flex; align-items: center; gap: 12px; background: #ffffff; padding: 6px 14px; border-radius: 30px; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.02); }

        .container { padding: 35px; }

        /* Cards Grid */
        .cards-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .card { padding: 24px; border-radius: 16px; position: relative; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04); background: #ffffff; border: 1px solid #e2e8f0; }
        .card-1 { border-left: 5px solid #2563eb; }
        .card-2 { border-left: 5px solid #059669; }
        .card-3 { border-left: 5px solid #d97706; }
        .card-4 { border-left: 5px solid #7c3aed; }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .card-header span { font-size: 13px; font-weight: 500; color: #64748b; }
        .card-header i { font-size: 16px; color: #2563eb; background: #f1f5f9; padding: 10px; border-radius: 10px; }
        .card p { font-size: 26px; font-weight: 700; color: #0f172a; }

        /* Action Bar */
        .action-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .action-bar h3 { font-size: 18px; font-weight: 600; color: #0f172a; }
        .action-buttons { display: flex; gap: 12px; }
        .btn-add { background: #2563eb; color: #ffffff; border: none; padding: 12px 22px; border-radius: 10px; font-weight: 650; font-size: 14px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2); }
        .btn-add:hover { background: #1d4ed8; }
        .btn-pdf { background: #059669; color: #ffffff; border: none; padding: 12px 20px; border-radius: 10px; font-weight: 650; font-size: 14px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.2); }
        .btn-pdf:hover { background: #047857; }

        /* Table */
        .table-container { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow-x: auto; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; white-space: nowrap; }
        th, td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; }
        th { background: #f8fafc; color: #475569; font-weight: 650; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
        tr:hover { background: #f8fafc; }
        td { color: #334155; }

        /* Modal UI */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px); justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: #ffffff; border: 1px solid #e2e8f0; padding: 35px; border-radius: 20px; width: 700px; max-height: 85vh; overflow-y: auto; box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .modal-content h3 { color: #0f172a; margin-bottom: 20px; font-size: 20px; font-weight: 650; display: flex; align-items: center; gap: 10px; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 5px; color: #475569; }
        .form-group input, .form-group select { width: 100%; padding: 10px 12px; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; color: #0f172a; font-size: 13px; outline: none; }
        .form-group input:focus, .form-group select:focus { border-color: #2563eb; background: #ffffff; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; grid-column: span 2; }
        .btn-close { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 10px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; }
        .btn-submit { background: #2563eb; color: #ffffff; border: none; padding: 10px 24px; border-radius: 10px; font-weight: 650; cursor: pointer; }
    </style>
</head>
<body>

    <!-- Sidebar Navigation -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <i class="fa-solid fa-chart-pie"></i> SPDA Admin Portal
        </div>
        <ul class="nav-links">
            <li class="nav-item active" onclick="switchNav('Dashboard', this)">
                <div class="nav-left"><i class="fa-solid fa-house"></i> Dashboard</div>
            </li>
            
            <li class="nav-item" onclick="switchNav('All', this)">
                <div class="nav-left"><i class="fa-solid fa-table-cells"></i> All Data Overview</div>
            </li>
            
            <!-- 1. District View Menu -->
            <li class="nav-item" onclick="toggleSub('districtSub', 'districtArrow', event)">
                <div class="nav-left"><i class="fa-solid fa-location-dot"></i> District View</div>
                <i class="fa-solid fa-chevron-down" id="districtArrow" style="font-size: 11px; transition: 0.3s;"></i>
            </li>
            <ul class="sub-menu" id="districtSub">
                <li onclick="selectDistrict('ගාල්ල', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> ගාල්ල (Galle)</li>
                <li onclick="selectDistrict('මාතර', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> මාතර (Matara)</li>
                <li onclick="selectDistrict('හම්බන්තොට', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> හම්බන්තොට (Hambantota)</li>
            </ul>
            <div class="filter-panel" id="districtFilterPanel">
                <h4 id="panelDistrictTitle">District Filters</h4>
                <div class="filter-group">
                    <label>Divisional Secretariat:</label>
                    <select id="filterDistrictDS" onchange="applyDistrictFilters()">
                        <option value="All">All DS Divisions</option>
                        <option value="වදිරම්බ">වදිරම්බ (Wadiramba)</option>
                        <option value="බෝපෙ-පෝද්දල">බෝපෙ-පෝද්දල (Bope-Poddala)</option>
                        <option value="කරන්දෙනිය">කරන්දෙනිය (Karandeniya)</option>
                        <option value="යක්කලමුල්ල">යක්කලමුල්ල (Yakkalamulla)</option>
                        <option value="අම්බලන්ගොඩ">අම්බලන්ගොඩ (Ambalangoda)</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Service Category:</label>
                    <select id="filterDistrictService" onchange="applyDistrictFilters()">
                        <option value="All">All Categories</option>
                        <option value="Export">Export</option>
                        <option value="Self-employment">Self-employment</option>
                        <option value="Small-scale">Small-scale</option>
                        <option value="Certified Trainees">Certified Trainees</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Nature of Business:</label>
                    <select id="filterDistrictNature" onchange="applyDistrictFilters()">
                        <option value="All">All Natures</option>
                        <option value="Agricultural value-added products">Agricultural value-added products</option>
                        <option value="Food products and dehydrated spices">Food products and dehydrated spices</option>
                        <option value="Textiles, batik, and garment making">Textiles, batik, and garment making</option>
                        <option value="Handicrafts, wood carvings, and ornamental items">Handicrafts, wood carvings, and ornamental items</option>
                        <option value="Flowers, ornamental plants, and foliage">Flowers, ornamental plants, and foliage</option>
                        <option value="Coir processing and related products">Coir processing and related products</option>
                        <option value="Industrial, printing, and machinery operation">Industrial, printing, and machinery operation</option>
                        <option value="Services and others">Services and others</option>
                    </select>
                </div>
            </div>

            <!-- 2. Divisional Secretariat Division Menu -->
            <li class="nav-item" onclick="toggleSub('dsSub', 'dsArrow', event)">
                <div class="nav-left"><i class="fa-solid fa-building-columns"></i> DS Division</div>
                <i class="fa-solid fa-chevron-down" id="dsArrow" style="font-size: 11px; transition: 0.3s;"></i>
            </li>
            <ul class="sub-menu" id="dsSub">
                <li onclick="selectDSDivision('වදිරම්බ', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> වදිරම්බ (Wadiramba)</li>
                <li onclick="selectDSDivision('බෝපෙ-පෝද්දල', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> බෝපෙ-පෝද්දල (Bope-Poddala)</li>
                <li onclick="selectDSDivision('කරන්දෙනිය', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> කරන්දෙනිය (Karandeniya)</li>
                <li onclick="selectDSDivision('යක්කලමුල්ල', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> යක්කලමුල්ල (Yakkalamulla)</li>
                <li onclick="selectDSDivision('අම්බලන්ගොඩ', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> අම්බලන්ගොඩ (Ambalangoda)</li>
            </ul>
            <div class="filter-panel" id="dsSearchPanel">
                <h4 id="panelDSTitle">GN Division Search</h4>
                <div class="filter-group">
                    <label>Type Grama Niladhari Initials/Name:</label>
                    <input type="text" id="gnSearchInput" placeholder="Type letters (e.g. 123, A...)" oninput="filterByGNSearch()">
                </div>
            </div>

            <!-- 3. Service Category Menu -->
            <li class="nav-item" onclick="toggleSub('serviceSub', 'serviceArrow', event)">
                <div class="nav-left"><i class="fa-solid fa-layer-group"></i> Service Category</div>
                <i class="fa-solid fa-chevron-down" id="serviceArrow" style="font-size: 11px; transition: 0.3s;"></i>
            </li>
            <ul class="sub-menu" id="serviceSub">
                <li onclick="selectServiceCategory('Export', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Exports</li>
                <li onclick="selectServiceCategory('Self-employment', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Self-Employment</li>
                <li onclick="selectServiceCategory('Small-scale', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> SMEs (Small-scale)</li>
                <li onclick="selectServiceCategory('Certified Trainees', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Certified Trainees</li>
            </ul>
            <div class="filter-panel" id="serviceFilterPanel">
                <h4 id="panelServiceTitle">Service Filters</h4>
                <div class="filter-group">
                    <label>Filter by District:</label>
                    <select id="filterServiceDistrict" onchange="applyServiceFilters()">
                        <option value="All">All Districts</option>
                        <option value="ගාල්ල">ගාල්ල (Galle)</option>
                        <option value="මාතර">මාතර (Matara)</option>
                        <option value="හම්බන්තොට">හම්බන්තොට (Hambantota)</option>
                    </select>
                </div>
            </div>

            <!-- 4. Nature of Business / Industry Menu (Updated with DS Division Filter) -->
            <li class="nav-item" onclick="toggleSub('natureSub', 'natureArrow', event)">
                <div class="nav-left"><i class="fa-solid fa-gears"></i> Nature of Business</div>
                <i class="fa-solid fa-chevron-down" id="natureArrow" style="font-size: 11px; transition: 0.3s;"></i>
            </li>
            <ul class="sub-menu" id="natureSub">
                <li onclick="selectNatureCategory('Agricultural value-added products', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Agricultural value-added products</li>
                <li onclick="selectNatureCategory('Food products and dehydrated spices', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Food products & dehydrated spices</li>
                <li onclick="selectNatureCategory('Textiles, batik, and garment making', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Textiles, batik & garment making</li>
                <li onclick="selectNatureCategory('Handicrafts, wood carvings, and ornamental items', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Handicrafts & ornamental items</li>
                <li onclick="selectNatureCategory('Flowers, ornamental plants, and foliage', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Flowers & ornamental plants</li>
                <li onclick="selectNatureCategory('Coir processing and related products', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Coir processing products</li>
                <li onclick="selectNatureCategory('Industrial, printing, and machinery operation', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Industrial, printing & machinery</li>
                <li onclick="selectNatureCategory('Services and others', event)"><i class="fa-solid fa-angle-right" style="font-size: 10px;"></i> Services and others</li>
            </ul>
            <div class="filter-panel" id="natureFilterPanel">
                <h4 id="panelNatureTitle">Industry Filters</h4>
                <div class="filter-group">
                    <label>Filter by District:</label>
                    <select id="filterNatureDistrict" onchange="applyNatureFilters()">
                        <option value="All">All Districts</option>
                        <option value="ගාල්ල">ගාල්ල (Galle)</option>
                        <option value="මාතර">මාතර (Matara)</option>
                        <option value="හම්බන්තොට">හම්බන්තොට (Hambantota)</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Filter by DS Division:</label>
                    <select id="filterNatureDS" onchange="applyNatureFilters()">
                        <option value="All">All DS Divisions</option>
                        <option value="වදිරම්බ">වදිරම්බ (Wadiramba)</option>
                        <option value="බෝපෙ-පෝද්දල">බෝපෙ-පෝද්දල (Bope-Poddala)</option>
                        <option value="කරන්දෙනිය">කරන්දෙනිය (Karandeniya)</option>
                        <option value="යක්කලමුල්ල">යක්කලමුල්ල (Yakkalamulla)</option>
                        <option value="අම්බලන්ගොඩ">අම්බලන්ගොඩ (Ambalangoda)</option>
                    </select>
                </div>
            </div>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <div class="header">
            <h2 id="pageTitle">Dashboard / <span>Overview</span></h2>
            <div class="user-profile">
                <span style="font-size: 13px; font-weight: 600; color: #334155;">Admin User</span>
            </div>
        </div>

        <div class="container">
            <!-- Cards Grid -->
            <div class="cards-grid" id="cardsGridContainer">
                <div class="card card-1">
                    <div class="card-header"><span>Total Records</span><i class="fa-solid fa-users"></i></div>
                    <p id="totalCount">3</p>
                </div>
                <div class="card card-2">
                    <div class="card-header"><span>Districts Covered</span><i class="fa-solid fa-map"></i></div>
                    <p>3 Districts</p>
                </div>
                <div class="card card-3">
                    <div class="card-header"><span>Service Categories</span><i class="fa-solid fa-layer-group"></i></div>
                    <p>4 Active</p>
                </div>
                <div class="card card-4">
                    <div class="card-header"><span>Industries</span><i class="fa-solid fa-gears"></i></div>
                    <p>8 Active</p>
                </div>
            </div>

            <div class="action-bar">
                <h3 id="tableSectionTitle">Registered Data Table</h3>
                <div class="action-buttons">
                    <button class="btn-pdf" onclick="downloadPDF()"><i class="fa-solid fa-file-pdf"></i> Download PDF</button>
                    <!-- Add button is visible only on Dashboard -->
                    <button class="btn-add" id="addBtnElement" onclick="openModal()"><i class="fa-solid fa-plus"></i> Add New Data</button>
                </div>
            </div>

            <!-- Table -->
            <div class="table-container">
                <table id="dataTable">
                    <thead>
                        <tr>
                            <th>නම (Name)</th>
                            <th>ලිපිනය</th>
                            <th>ජා.හැ. අංකය</th>
                            <th>දුරකතන</th>
                            <th>වට්ස්ඇප්</th>
                            <th>ඊමේල්</th>
                            <th>දිස්ත්‍රික්කය</th>
                            <th>ප්‍රා.ලේ. කොට්ඨාසය</th>
                            <th>ග්‍රා.නි. කොට්ඨාසය</th>
                            <th>සේවා කාණ්ඩය</th>
                            <th>ව්‍යාපාරයේ ස්වභාවය</th>
                            <th>ව්‍යාපාරයේ නම</th>
                            <th>ලියාපදිංචි අංකය සහ දිනය</th>
                            <th>සේවක සංඛ්‍යාව</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <!-- Dynamic rows -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Form (Only accessible via Dashboard) -->
    <div class="modal" id="dataModal">
        <div class="modal-content">
            <h3><i class="fa-solid fa-user-plus" style="color: #2563eb;"></i> Add New Entrepreneur Form</h3>
            <form id="entryForm" onsubmit="addData(event)" class="form-grid">
                <div class="form-group"><label>නම (Name)</label><input type="text" id="name" required></div>
                <div class="form-group"><label>ලිපිනය (Address)</label><input type="text" id="address" required></div>
                <div class="form-group"><label>ජා.හැ. අංකය (NIC)</label><input type="text" id="nic" required></div>
                <div class="form-group"><label>දුරකතන අංකය (Phone)</label><input type="text" id="phone" required></div>
                <div class="form-group"><label>වට්ස්ඇප් අංකය (WhatsApp)</label><input type="text" id="whatsapp"></div>
                <div class="form-group"><label>ඊමේල් (Email)</label><input type="email" id="email"></div>
                
                <div class="form-group">
                    <label>දිස්ත්‍රික්කය (District)</label>
                    <select id="district">
                        <option value="ගාල්ල">ගාල්ල</option>
                        <option value="මාතර">මාතර</option>
                        <option value="හම්බන්තොට">හම්බන්තොට</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>ප්‍රාදේශීය ලේකම් කොට්ඨාසය (DS Division)</label>
                    <select id="dsDivision">
                        <option value="වදිරම්බ">වදිරම්බ (Wadiramba)</option>
                        <option value="බෝපෙ-පෝද්දල">බෝපෙ-පෝද්දල (Bope-Poddala)</option>
                        <option value="කරන්දෙනිය">කරන්දෙනිය (Karandeniya)</option>
                        <option value="යක්කලමුල්ල">යක්කලමුල්ල (Yakkalamulla)</option>
                        <option value="අම්බලන්ගොඩ">අම්බලන්ගොඩ (Ambalangoda)</option>
                    </select>
                </div>

                <div class="form-group"><label>ග්‍රා.නි. කොට්ඨාසය (GN Division)</label><input type="text" id="gnDivision" required></div>

                <div class="form-group">
                    <label>සේවා කාණ්ඩය (Service Category)</label>
                    <select id="serviceCat">
                        <option value="Export">Export</option>
                        <option value="Self-employment">Self-employment</option>
                        <option value="Small-scale">Small-scale</option>
                        <option value="Certified Trainees">Certified Trainees</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>ව්‍යාපාරයේ ස්වභාවය (Nature of Business)</label>
                    <select id="natureBus">
                        <option value="Agricultural value-added products">Agricultural value-added products</option>
                        <option value="Food products and dehydrated spices">Food products and dehydrated spices</option>
                        <option value="Textiles, batik, and garment making">Textiles, batik, and garment making</option>
                        <option value="Handicrafts, wood carvings, and ornamental items">Handicrafts, wood carvings, and ornamental items</option>
                        <option value="Flowers, ornamental plants, and foliage">Flowers, ornamental plants, and foliage</option>
                        <option value="Coir processing and related products">Coir processing and related products</option>
                        <option value="Industrial, printing, and machinery operation">Industrial, printing, and machinery operation</option>
                        <option value="Services and others">Services and others</option>
                    </select>
                </div>

                <div class="form-group"><label>ව්‍යාපාරයේ නම (Business Name)</label><input type="text" id="bName" required></div>
                <div class="form-group"><label>ලියාපදිංචි අංකය සහ දිනය (Reg No & Date)</label><input type="text" id="regDetails" required></div>
                <div class="form-group"><label>සේවක සංඛ්‍යාව (Number of Employees)</label><input type="number" id="employees" required></div>

                <div class="modal-actions">
                    <button type="button" class="btn-close" onclick="closeModal()">Cancel</button>
                    <button type="submit" class="btn-submit">Save Data</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Script helper -->
    <script>
        let entrepreneurs = [
            { name: "එන්.වී. රිෂාන්", address: "ගාල්ල", nic: "991234567V", phone: "0711980361", whatsapp: "0711980361", email: "rishan@gmail.com", district: "ගාල්ල", ds: "බෝපෙ-පෝද්දල", gn: "123 A", service: "Export", nature: "Agricultural value-added products", bName: "Jack Fruit Ceylon", reg: "REG-2024-01", employees: 5 },
            { name: "කුමාර පෙරේරා", address: "මාතර", nic: "882345678V", phone: "0723456789", whatsapp: "0723456789", email: "kumara@gmail.com", district: "මාතර", ds: "යක්කලමුල්ල", gn: "456 B", service: "Self-employment", nature: "Handicrafts, wood carvings, and ornamental items", bName: "Matara Lace House", reg: "REG-2024-02", employees: 3 },
            { name: "සුනිල් රත්නායක", address: "හම්බන්තොට", nic: "773456789V", phone: "0771234567", whatsapp: "0771234567", email: "sunil@gmail.com", district: "හම්බන්තොට", ds: "වදිරම්බ", gn: "789 C", service: "Small-scale", nature: "Textiles, batik, and garment making", bName: "Hansa Garments", reg: "REG-2024-03", employees: 8 }
        ];

        let currentMode = 'Dashboard';
        let activeDistrict = null;
        let activeDS = null;
        let activeService = null;
        let activeNature = null;
        let currentFilteredData = entrepreneurs;

        function renderTable(dataToRender) {
            currentFilteredData = dataToRender;
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = "";
            dataToRender.forEach(item => {
                tbody.innerHTML += `<tr>
                    <td><strong style="color:#0f172a;">${item.name}</strong></td>
                    <td>${item.address}</td>
                    <td>${item.nic}</td>
                    <td>${item.phone}</td>
                    <td>${item.whatsapp}</td>
                    <td>${item.email}</td>
                    <td><span style="background: #eff6ff; color: #2563eb; padding: 4px 10px; border-radius: 20px; font-weight:600;">${item.district}</span></td>
                    <td>${item.ds}</td>
                    <td>${item.gn}</td>
                    <td>${item.service}</td>
                    <td>${item.nature}</td>
                    <td>${item.bName}</td>
                    <td>${item.reg}</td>
                    <td>${item.employees}</td>
                </tr>`;
            });
            document.getElementById('totalCount').innerText = dataToRender.length;
        }

        function hideAllSubAndPanels() {
            document.getElementById('districtSub').style.display = 'none';
            document.getElementById('districtFilterPanel').style.display = 'none';
            document.getElementById('districtArrow').style.transform = 'rotate(0deg)';
            
            document.getElementById('dsSub').style.display = 'none';
            document.getElementById('dsSearchPanel').style.display = 'none';
            document.getElementById('dsArrow').style.transform = 'rotate(0deg)';
            
            document.getElementById('serviceSub').style.display = 'none';
            document.getElementById('serviceFilterPanel').style.display = 'none';
            document.getElementById('serviceArrow').style.transform = 'rotate(0deg)';
            
            document.getElementById('natureSub').style.display = 'none';
            document.getElementById('natureFilterPanel').style.display = 'none';
            document.getElementById('natureArrow').style.transform = 'rotate(0deg)';
        }

        function switchNav(mode, element) {
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            if(element) element.classList.add('active');
            
            currentMode = mode;
            hideAllSubAndPanels();
            
            const addBtn = document.getElementById('addBtnElement');
            if (mode === 'Dashboard') {
                addBtn.style.display = 'flex';
                document.getElementById('pageTitle').innerHTML = "Dashboard / <span>Overview</span>";
                renderTable(entrepreneurs);
            } else if (mode === 'All') {
                addBtn.style.display = 'none';
                document.getElementById('pageTitle').innerHTML = "All Data Overview / <span>List</span>";
                renderTable(entrepreneurs);
            }
        }

        function toggleSub(subId, arrowId, e) {
            e.stopPropagation();
            let sub = document.getElementById(subId);
            let arrow = document.getElementById(arrowId);
            
            let isOpen = (sub.style.display === 'block');
            hideAllSubAndPanels();
            
            if (!isOpen) {
                sub.style.display = 'block';
                arrow.style.transform = 'rotate(180deg)';
                document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
                e.currentTarget.classList.add('active');

                if(subId === 'dsSub') {
                    document.getElementById('dsSearchPanel').style.display = 'block';
                    document.getElementById('panelDSTitle').innerText = "GN Division Search";
                    document.getElementById('gnSearchInput').value = "";
                    currentMode = 'DS_Menu';
                    document.getElementById('addBtnElement').style.display = 'none';
                    document.getElementById('pageTitle').innerHTML = "Divisional Secretariat / <span>GN Search</span>";
                    filterByGNSearch();
                }
            }
        }

        // District Selection & Interconnected Filters
        function selectDistrict(districtName, e) {
            e.stopPropagation();
            activeDistrict = districtName;
            currentMode = 'District';
            document.getElementById('addBtnElement').style.display = 'none';
            
            let panel = document.getElementById('districtFilterPanel');
            panel.style.display = 'block';
            document.getElementById('panelDistrictTitle').innerText = districtName + " - Filters";
            
            document.getElementById('filterDistrictDS').value = "All";
            document.getElementById('filterDistrictService').value = "All";
            document.getElementById('filterDistrictNature').value = "All";

            document.getElementById('pageTitle').innerHTML = `District View / <span>${districtName}</span>`;
            applyDistrictFilters();
        }

        function applyDistrictFilters() {
            if (!activeDistrict) return;
            let dsVal = document.getElementById('filterDistrictDS').value;
            let serviceVal = document.getElementById('filterDistrictService').value;
            let natureVal = document.getElementById('filterDistrictNature').value;

            let filtered = entrepreneurs.filter(item => {
                return item.district === activeDistrict &&
                       (dsVal === 'All' || item.ds === dsVal) &&
                       (serviceVal === 'All' || item.service === serviceVal) &&
                       (natureVal === 'All' || item.nature === natureVal);
            });
            renderTable(filtered);
        }

        // DS Division Selection via Sub-menu list
        function selectDSDivision(dsName, e) {
            e.stopPropagation();
            activeDS = dsName;
            currentMode = 'DS_Division';
            document.getElementById('addBtnElement').style.display = 'none';
            document.getElementById('dsSearchPanel').style.display = 'block';
            document.getElementById('panelDSTitle').innerText = dsName + " - GN Search";

            document.getElementById('pageTitle').innerHTML = `DS Division / <span>${dsName}</span>`;
            
            let query = document.getElementById('gnSearchInput').value.toLowerCase().trim();
            let filtered = entrepreneurs.filter(item => {
                return item.ds === dsName && (query === '' || item.gn.toLowerCase().includes(query));
            });
            renderTable(filtered);
        }

        function filterByGNSearch() {
            let query = document.getElementById('gnSearchInput').value.toLowerCase().trim();
            document.getElementById('pageTitle').innerHTML = `Divisional Secretariat / <span>GN Search: "${query}"</span>`;
            let filtered = entrepreneurs.filter(item => item.gn.toLowerCase().includes(query));
            renderTable(filtered);
        }

        // Service Category Selection & Interconnected Filters
        function selectServiceCategory(serviceName, e) {
            e.stopPropagation();
            activeService = serviceName;
            currentMode = 'Service';
            document.getElementById('addBtnElement').style.display = 'none';

            let panel = document.getElementById('serviceFilterPanel');
            panel.style.display = 'block';
            document.getElementById('panelServiceTitle').innerText = serviceName + " - Filters";
            document.getElementById('filterServiceDistrict').value = "All";

            document.getElementById('pageTitle').innerHTML = `Service Category / <span>${serviceName}</span>`;
            applyServiceFilters();
        }

        function applyServiceFilters() {
            if (!activeService) return;
            let distVal = document.getElementById('filterServiceDistrict').value;

            let filtered = entrepreneurs.filter(item => {
                return item.service === activeService &&
                       (distVal === 'All' || item.district === distVal);
            });
            renderTable(filtered);
        }

        // Nature of Business Selection & Interconnected Filters (District & DS Division)
        function selectNatureCategory(natureName, e) {
            e.stopPropagation();
            activeNature = natureName;
            currentMode = 'Nature';
            document.getElementById('addBtnElement').style.display = 'none';

            let panel = document.getElementById('natureFilterPanel');
            panel.style.display = 'block';
            document.getElementById('panelNatureTitle').innerText = "Industry Filters";
            document.getElementById('filterNatureDistrict').value = "All";
            document.getElementById('filterNatureDS').value = "All";

            document.getElementById('pageTitle').innerHTML = `Nature of Business / <span>${natureName}</span>`;
            applyNatureFilters();
        }

        function applyNatureFilters() {
            if (!activeNature) return;
            let distVal = document.getElementById('filterNatureDistrict').value;
            let dsVal = document.getElementById('filterNatureDS').value;

            let filtered = entrepreneurs.filter(item => {
                return item.nature === activeNature &&
                       (distVal === 'All' || item.district === distVal) &&
                       (dsVal === 'All' || item.ds === dsVal);
            });
            renderTable(filtered);
        }

        // PDF Download function using browser print preview
        function downloadPDF() {
            window.print();
        }

        // Modal Functions (Data Entry restricted to Dashboard)
        function openModal() { 
            if(currentMode !== 'Dashboard') {
                alert("Data entry is only allowed via the Dashboard view!");
                return;
            }
            document.getElementById('dataModal').style.display = 'flex'; 
        }
        function closeModal() { document.getElementById('dataModal').style.display = 'none'; }

        function addData(e) {
            e.preventDefault();
            const newItem = {
                name: document.getElementById('name').value,
                address: document.getElementById('address').value,
                nic: document.getElementById('nic').value,
                phone: document.getElementById('phone').value,
                whatsapp: document.getElementById('whatsapp').value,
                email: document.getElementById('email').value,
                district: document.getElementById('district').value,
                ds: document.getElementById('dsDivision').value,
                gn: document.getElementById('gnDivision').value,
                service: sdocument.getElementById('serviceCat').value,
                nature: document.getElementById('natureBus').value,
                bName: document.getElementById('bName').value,
                reg: document.getElementById('regDetails').value,
                employees: document.getElementById('employees').value
            };
            entrepreneurs.push(newItem);
            renderTable(entrepreneurs);
            closeModal();
            document.getElementById('entryForm').reset();
        }

        // Initial load
        renderTable(entrepreneurs);
    </script>
</body>
</html>